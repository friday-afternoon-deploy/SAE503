# Copier ce fichier en .env et remplacer les valeurs.
# Le fichier .env ne doit jamais être envoyé sur GitHub.

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sae503
DB_USER=gestion
DB_PASSWORD=a_remplacer
DB_ROOT_PASSWORD=a_remplacer

# Broker MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=gestion
MQTT_PASSWORD=a_remplacer

# Grafana
GRAFANA_ADMIN_PASSWORD=a_remplacer

# Prises cloud
MEROSS_EMAIL=a_remplacer
MEROSS_PASSWORD=a_remplacer

# Météo (optionnel)
OPENWEATHER_KEY=a_remplacer

# Fonctionnement du script de gestion
MAISON=maison1
MODE_DEMO=0
PRISES_FACTICES=1
