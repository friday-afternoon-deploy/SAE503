        "spec": {
          "id": 1,
          "title": "production, consommation et surplus",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "spec": {
                        "dataset": "sae503",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT m.horodatage AS time,\n  MAX(CASE WHEN m.type_mesure = 'production'   THEN m.valeur END) AS Production,\n  MAX(CASE WHEN m.type_mesure = 'consommation' THEN m.valeur END) AS Consommation,\n  MAX(CASE WHEN m.type_mesure = 'surplus'      THEN m.valeur END) AS Surplus\nFROM mesure m JOIN objet o ON o.id_objet = m.id_objet\nWHERE o.identifiant = 'onduleur1' AND $__timeFilter(m.horodatage)\nGROUP BY m.horodatage\nORDER BY m.horodatage",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
